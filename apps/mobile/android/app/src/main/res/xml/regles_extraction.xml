<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne part dans les sauvegardes du téléphone ni lors d'un transfert vers un
     autre appareil. Le texte et le PDF des ouvrages réservés à l'application y
     sont chiffrés avec une clé du Keystore, qui ne quitte pas l'appareil : les
     restaurer ailleurs donnerait des fichiers illisibles, et les laisser partir
     ferait sortir du téléphone ce qui ne doit se lire que dans ASCENDA. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
