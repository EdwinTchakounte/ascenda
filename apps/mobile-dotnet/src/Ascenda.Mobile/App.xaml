<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:plateforme="clr-namespace:Ascenda.Mobile.Plateforme"
             x:Class="Ascenda.Mobile.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Couleurs.xaml" />
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <plateforme:Inverse x:Key="Inverse" />
      <plateforme:NonNul x:Key="NonNul" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
