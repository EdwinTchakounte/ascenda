<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modeles="clr-namespace:Ascenda.Noyau.Modeles;assembly=Ascenda.Noyau"
             x:Class="Ascenda.Mobile.Pages.CorrectionPage"
             Title="Correction" Shell.TabBarIsVisible="False">

  <ScrollView>
    <VerticalStackLayout Padding="20,12,20,28" Spacing="16">

      <Border Style="{StaticResource Heros}">
        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
          <Label Style="{StaticResource Titre}" TextColor="{StaticResource SurHeros}"
                 FontSize="34" HorizontalTextAlignment="Center"
                 Text="{Binding Correction.Justes, StringFormat='{0}'}" />
          <Label Style="{StaticResource Crochet}" TextColor="{StaticResource AccentSurHeros}"
                 HorizontalTextAlignment="Center"
                 Text="{Binding Correction.Mention}" />
          <Label Style="{StaticResource Attenue}" TextColor="{StaticResource SurHerosDoux}"
                 HorizontalTextAlignment="Center"
                 Text="Les notions manquées reviendront en révision espacée." />
        </VerticalStackLayout>
      </Border>

      <Label Text="Question par question" Style="{StaticResource TitreCarte}" />

      <CollectionView ItemsSource="{Binding Correction.Verdicts}" SelectionMode="None">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="modeles:Verdict">
            <Border Style="{StaticResource Carte}" Margin="0,0,0,10">
              <VerticalStackLayout Spacing="8">
                <Label Text="{Binding Marque}" Style="{StaticResource Crochet}" />
                <Label Text="{Binding Explication}" Style="{StaticResource Attenue}" />
                <BoxView Style="{StaticResource Filet}"
                         IsVisible="{Binding Citation, Converter={StaticResource NonNul}}" />
                <Label Text="{Binding Citation}" FontFamily="Fraunces" FontSize="14"
                       IsVisible="{Binding Citation, Converter={StaticResource NonNul}}" />
                <Label Text="{Binding Page, StringFormat='p. {0}'}"
                       Style="{StaticResource Crochet}"
                       IsVisible="{Binding Page, Converter={StaticResource NonNul}}" />
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
