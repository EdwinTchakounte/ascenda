<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Ascenda.Mobile.Pages"
       x:Class="Ascenda.Mobile.AppShell"
       Shell.FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{StaticResource Surface}"
       Title="ASCENDA">

  <ShellContent Route="bienvenue"
                ContentTemplate="{DataTemplate pages:BienvenuePage}"
                FlyoutItemIsVisible="False" />

  <TabBar Route="onglets">
    <ShellContent Title="Le jour" Route="jour"
                  ContentTemplate="{DataTemplate pages:JourPage}" />
    <ShellContent Title="Les livres" Route="livres"
                  ContentTemplate="{DataTemplate pages:BibliothequePage}" />
    <ShellContent Title="L'agent" Route="agent"
                  ContentTemplate="{DataTemplate pages:AgentPage}" />
    <ShellContent Title="Le chemin" Route="chemin"
                  ContentTemplate="{DataTemplate pages:ProgressionPage}" />
  </TabBar>

</Shell>
