# ─── Module mail (Brevo HTTP API via django-anymail) ───────────────────────
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Mon Projet <noreply@mondomaine.com>
CONTACT_NOTIFICATION_EMAIL=contact@mondomaine.com
# En dev, surcharger avec :
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ─── Module paiement (mobile money Tara) ───────────────────────────────────
TARA_API_KEY=
TARA_BUSINESS_ID=
TARA_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://api.mondomaine.com
# Modes test — TOUJOURS false en prod :
PAYMENTS_TEST_AUTO_VALIDATE=false
PAYMENTS_TEST_ALLOW_ANY_AMOUNT=false
