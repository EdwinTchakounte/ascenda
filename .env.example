# ---- ASCENDA (ports choisis pour ne pas entrer en conflit avec les stacks existantes)
POSTGRES_HOST=localhost
POSTGRES_PORT=5450
POSTGRES_DB=ascenda
POSTGRES_USER=ascenda
POSTGRES_PASSWORD=change_me
MINIO_ENDPOINT=localhost:9250
MINIO_ROOT_USER=ascenda
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=ascenda-docs
MINIO_SECURE=false
API_PORT=8250
REDIS_PORT=6390
ANTHROPIC_API_KEY=
EMBED_MODEL=intfloat/multilingual-e5-large
# Embarque torch et sentence-transformers dans l'image de l'API : deux
# gigaoctets de plus, et deux autres au premier démarrage pour le modèle.
# À faux, la recherche est en plein texte et l'API le dit dans `mode`.
RECHERCHE_SEMANTIQUE=false

# ---- API
API_ENV=dev
# En production : générer avec `openssl rand -base64 48`. L'API refuse de démarrer
# en prod tant que cette valeur reste celle par défaut.
JWT_SECRET=dev-secret-a-remplacer
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=60
API_CORS_ORIGINS=http://localhost:3251,http://localhost:3250
AGENT_MODEL=claude-opus-5
# Nombre de passages du corpus envoyés à l'agent pour une question directe.
AGENT_MAX_CONTEXT_CHUNKS=8
JWT_ALGORITHM=HS256

# ---- Paiement (Tara mobile money : MTN et Orange Cameroun)
# Sans ces deux clés, le fournisseur tourne en mode simulé.
TARA_API_KEY=
TARA_BUSINESS_ID=
PUBLIC_BASE_URL=http://localhost:8250
# Adresse publique de la vitrine. Figée à la construction de l'image :
# la changer demande un `docker compose build vitrine`, pas un redémarrage.
SITE_BASE_URL=http://localhost:3251
# Valide les paiements sans encaisser. L'API refuse de démarrer avec API_ENV=prod.
PAIEMENT_TEST_AUTO_VALIDE=false
RECONCILIATION_TIMEOUT_HEURES=24
# Pause entre deux interrogations du fournisseur pendant la réconciliation.
# À zéro uniquement pour les tests : en production, on ménage l'API de Tara.
RECONCILIATION_PAUSE_SECONDES=20

# ---- Courrier transactionnel (Brevo)
# Sans cette clé, les messages sont composés, tracés dans `email_log` avec le
# statut `simule`, et ne quittent pas la machine. Utile en développement,
# à poser en production sinon personne ne reçoit son reçu de paiement.
BREVO_API_KEY=
MAIL_EXPEDITEUR=ASCENDA <ne-pas-repondre@ascenda.app>

# ---- Vitrine (figées à la construction de l'image, pas au démarrage)
# Où mène le bouton « Commencer ». Vides, les pages le disent au lieu
# d'afficher un bouton qui ne mène nulle part.
APP_URL=
APK_URL=
# Identité de l'éditeur pour les pages légales. Ce qui reste vide s'affiche sur
# la page comme « à renseigner avant la mise en ligne ».
CONTACT_EMAIL=contact@ascenda.app
FORME_JURIDIQUE=
IMMATRICULATION=
ADRESSE=
TELEPHONE_PUBLIC=
HEBERGEUR=
